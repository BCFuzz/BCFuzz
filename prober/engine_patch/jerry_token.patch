+struct shmem_data* __shmem;
+struct token_shmem_data* __token_shmem;
+struct token_shmem_data* __line_shmem;
+struct bc_shmem_data* __bc_shmem;
+struct bc_shmem_data* __bc_line_shmem;
+
+int my_start_record = 1; // default 1, 0 for syntax/semantic error
+int my_start_record2 = 0; // default 0, 1 in trace_pc_guard, and 0 in ERBlocks
+int be_able_to_trace_pc_guard = 0;
