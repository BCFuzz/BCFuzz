+
+void my_add_token(int token_id)
+{
+    if(my_start_record==0 || my_start_record2==0)
+        return;
+    int index = (int)__token_shmem->loc;
+    __token_shmem->edges[index] = (uint32_t)token_id;
+    __token_shmem->loc++;
+    if(__token_shmem->loc >= (0x40000-4))
+    {
+        my_start_record=0; // myrecord
+        __token_shmem->loc = 0; // token_shmem len
+    }
+    printf("token:%d, ", token_id);
+}
+
+void my_add_line(int line_id)
+{
+    if(my_start_record==0 || my_start_record2==0)
+        return;
+    int index = (int)__line_shmem->loc;
+    __line_shmem->edges[index] = (uint32_t)line_id;
+    __line_shmem->loc++;
+    if(__line_shmem->loc >= (0x40000-4))
+    {
+        my_start_record=0; // myrecord
+        __line_shmem->loc = 0; // token_shmem len
+    }
+    printf("line:%d\n", line_id);
+}
+
+void my_add_bc(int bc_id, int bc_line)
+{
+    if(my_start_record==0 || my_start_record2==0)
+        return;
+    int index = (int)__bc_shmem->loc;
+    printf("index:%d, bytecode_id:%d, bytecode_line:%d\n", index, bc_id, bc_line);
+
+    __bc_shmem->edges[index] = (uint32_t)bc_id;
+    __bc_line_shmem->edges[index] = (uint32_t)bc_line;
+    __bc_shmem->loc++;
+    __bc_line_shmem->loc++;
+    if(__bc_shmem->loc >= 4090) // about (0x1000-1)
+    {
+        __bc_shmem->loc = 0;
+        __bc_line_shmem->loc = 0;
+    }
+}
